# ==============================================================================
# Women's Fitness Coaching — Environment Variables Configuration
# Copy this file to .env.local for local development. Never commit .env.local to Git.
# ==============================================================================

# Application Base URL (Canonical URL for SEO & OpenGraph metadata)
NEXT_PUBLIC_SITE_URL=https://example.com

# ------------------------------------------------------------------------------
# 1. Supabase Configuration (Phase 7 CMS & Database)
# Find these in your Supabase project dashboard -> Settings -> API
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Server-side only: Used for admin user provisioning and server migrations. Never expose in client code.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# 2. Cloudinary Media Storage (Phase 7 Media Library)
# Find these in your Cloudinary console dashboard -> Product Environment Credentials
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ------------------------------------------------------------------------------
# 3. Contact Form Email Provider (Optional)
# Set RESEND_API_KEY or CONTACT_EMAIL_WEBHOOK to enable live external email delivery.
# If unset, the form operates in local demo mode with honest disclosure.
# ------------------------------------------------------------------------------
RESEND_API_KEY=
CONTACT_EMAIL_WEBHOOK=

# ------------------------------------------------------------------------------
# 2. Appointment Booking Synchronization (Optional)
# Set your Acuity Scheduling or Calendly token to sync appointments into your calendar.
# If unset, inquiries are received as consultation requests without automated booking.
# ------------------------------------------------------------------------------
ACUITY_API_KEY=
CALENDLY_TOKEN=

# ------------------------------------------------------------------------------
# 3. Email Marketing / Newsletter Integration (Optional)
# Set your email marketing provider key for VIP newsletter and lead magnet downloads.
# ------------------------------------------------------------------------------
NEWSLETTER_API_KEY=
